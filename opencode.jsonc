{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/ocg/deepseek-v4-flash",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "share": "disabled",
  "provider": {
    "9router": {
      "name": "9Router Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["NINEROUTER_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:NINEROUTER_API_KEY}",
        "setCacheKey": true,
        "timeout": 300000, "headerTimeout": 90000, "chunkTimeout": 120000
      },
      "models": {
        "ocg/deepseek-v4-flash": { "name": "ocg/deepseek-v4-flash", "reasoning": true, "tool_call": true, "limit": { "context": 1000000, "output": 128000 } },
        "oc/nemotron-3-ultra-free": { "name": "oc/nemotron-3-ultra-free", "reasoning": true, "tool_call": true, "limit": { "context": 1000000, "output": 128000 } }
      }
    }
  },
  "agent": {
    "orchestrator": { "mode": "primary", "model": "9router/ocg/deepseek-v4-flash", "temperature": 0.2, "steps": 40,
      "permission": { "edit": "deny", "bash": "deny", "question": "allow", "todowrite": "allow", "task": { "*": "deny", "researcher": "allow", "reviewer": "allow", "executor": "allow" } } },
    "researcher": { "mode": "subagent", "model": "9router/oc/nemotron-3-ultra-free", "temperature": 0.1, "steps": 30,
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "webfetch": "allow", "websearch": "allow", "lsp": "allow", "skill": "allow", "task": "deny" } },
    "reviewer": { "mode": "subagent", "model": "9router/oc/nemotron-3-ultra-free", "temperature": 0.1, "steps": 30,
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "webfetch": "allow", "websearch": "allow", "lsp": "allow", "skill": "allow", "task": "deny" } },
    "executor": { "mode": "subagent", "model": "9router/ocg/deepseek-v4-flash", "steps": 50,
      "permission": { "read": "allow", "edit": "allow", "glob": "allow", "grep": "allow", "list": "allow", "bash": "allow", "lsp": "allow", "skill": "allow", "task": "deny" } },
    "title": { "model": "9router/oc/nemotron-3-ultra-free", "mode": "primary", "hidden": true },
    "summary": { "model": "9router/oc/nemotron-3-ultra-free", "mode": "primary", "hidden": true },
    "compaction": { "model": "9router/ocg/deepseek-v4-flash", "mode": "primary", "hidden": true }
  },
  "experimental": { "primary_tools": ["todowrite", "question"] },
  "compaction": { "auto": true },
  "lsp": true,
  "formatter": true
}
