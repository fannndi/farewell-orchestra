{
  "$schema": "https://opencode.ai/config.json",

  "model": "9router/{env:MODEL_A}",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "share": "disabled",
  "snapshot": true,
  "autoupdate": "notify",
  "logLevel": "DEBUG",
  "instructions": ["AGENTS.md"],

  "provider": {
    "9router": {
      "name": "9Router Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["NINEROUTER_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "timeout": 300000, "headerTimeout": 90000, "chunkTimeout": 120000
      },
      "models": {
        "Pro":   { "tool_call": true, "reasoning": true },
        "Flash": { "tool_call": true, "reasoning": true },
        "Free":  { "tool_call": true, "reasoning": true },
        "Codex": { "tool_call": true, "reasoning": true }
      }
    }
  },

  "permission": {
    "external_directory": "ask",
    "read": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" }
  },

  "experimental": {
    "primary_tools": ["todowrite", "question"]
  },

  "agent": {
    "build":      { "permission": { "task": "deny" } },
    "plan":       { "permission": { "task": "deny" } },
    "general":    { "permission": { "task": "deny" } },
    "explore":    { "permission": { "task": "deny" } },
    "title":      { "model": "9router/{env:MODEL_B}", "mode": "primary", "hidden": true },
    "summary":    { "model": "9router/{env:MODEL_B}", "mode": "primary", "hidden": true },
    "compaction": { "model": "9router/{env:MODEL_B}", "mode": "primary", "hidden": true }
  },

  "compaction": { "auto": true, "prune": false, "tail_turns": 2 },
  "lsp": true,
  "formatter": true
}