{
  "$schema": "https://opencode.ai/config.json",

  // Profile: A=MODEL_A  B=MODEL_B  C=MODEL_C
  "model": "9router/MODEL_A",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "share": "disabled",
  "shell": "powershell",
  "snapshot": true,
  "autoupdate": "notify",
  "small_model": "9router/MODEL_B",
  "logLevel": "DEBUG",

  "enabled_providers": ["9router"],
  "provider": {
    "9router": {
      "name": "9Router Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["NINEROUTER_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "timeout": 300000, "headerTimeout": 90000, "chunkTimeout": 120000
      },
      "models": {
        "ocg/deepseek-v4-pro":        { "tool_call": true, "reasoning": true, "limit": { "context": 1000000, "output": 128000 } },
        "ocg/deepseek-v4-flash":      { "tool_call": true, "reasoning": true, "limit": { "context": 1000000, "output": 128000 } },
        "oc/deepseek-v4-flash-free":  { "tool_call": true, "reasoning": true, "limit": { "context": 1000000, "output": 128000 } }
      }
    }
  },

  "instructions": ["AGENTS.md"],

  "command": {
    "status":  { "description": "Orchestration health check",                              "template": "Report orchestration state: active agent, model, token usage, pending tasks." },
    "fanout":  { "description": "Researcher + reviewer in parallel, then executor",        "template": "Fan out: $ARGUMENTS" },
    "review":  { "description": "Code review via reviewer â€” no edits", "agent": "reviewer", "subtask": true, "template": "Review for architecture/security/correctness. No edits: $ARGUMENTS" },
    "execute": { "description": "Delegate implementation to executor",    "agent": "executor", "subtask": true, "template": "Implement: $ARGUMENTS" }
  },

  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask",
    "plan_enter": "deny", "plan_exit": "deny",
    "read": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" }
  },

  "experimental": {
    "primary_tools": ["todowrite", "question"],
    "continue_loop_on_deny": true,
    "mcp_timeout": 30000
  },

  "agent": {
    "orchestrator": {
      "description": "Workflow orchestrator â€” decompose, fan-out researcher+reviewer, synthesize, delegate to executor.",
      "mode": "primary", "model": "9router/MODEL_A", "color": "#7c3aed", "temperature": 0.2, "top_p": 0.5, "steps": 40,
      "prompt": "{file:./persona/orchestrator.persona.md}",
      "permission": { "edit": "deny", "bash": "deny", "question": "allow", "todowrite": "allow", "task": { "*": "deny", "researcher": "allow", "reviewer": "allow", "executor": "allow" } }
    },
    "researcher": {
      "description": "Read-only codebase investigator.",
      "mode": "subagent", "model": "9router/MODEL_B", "color": "#3b82f6", "temperature": 0.1, "top_p": 0.9, "steps": 30,
      "prompt": "{file:./persona/researcher.persona.md}",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "webfetch": "allow", "websearch": "allow", "lsp": "allow", "skill": "allow", "task": "deny" }
    },
    "reviewer": {
      "description": "Read-only security/architecture auditor.",
      "mode": "subagent", "model": "9router/MODEL_B", "color": "#f59e0b", "temperature": 0.1, "top_p": 0.9, "steps": 30,
      "prompt": "{file:./persona/reviewer.persona.md}",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "webfetch": "allow", "websearch": "allow", "lsp": "allow", "skill": "allow", "task": "deny" }
    },
    "executor": {
      "description": "Sole implementation worker â€” writes files, runs shell.",
      "mode": "subagent", "model": "9router/MODEL_B", "color": "#10b981", "steps": 50,
      "prompt": "{file:./persona/executor.persona.md}",
      "permission": { "read": "allow", "edit": "allow", "glob": "allow", "grep": "allow", "list": "allow", "bash": "allow", "lsp": "allow", "skill": "allow", "task": "deny" }
    },
    "build":      { "mode": "primary",   "color": "primary",   "permission": { "task": "deny" } },
    "plan":       { "mode": "primary",   "color": "secondary", "permission": { "task": "deny" } },
    "general":    { "mode": "subagent",  "permission": { "task": "deny" } },
    "explore":    { "mode": "subagent",  "permission": { "task": "deny" } },
    "title":      { "model": "9router/MODEL_B", "mode": "primary", "hidden": true },
    "summary":    { "model": "9router/MODEL_B", "mode": "primary", "hidden": true },
    "compaction": { "model": "9router/MODEL_B", "mode": "primary", "hidden": true }
  },

  "tool_output": { "max_lines": 2000, "max_bytes": 51200 },
  "compaction":  { "auto": true, "prune": false, "tail_turns": 2 },
  "watcher":     { "ignore": [".git/**", "node_modules/**", "dist/**", "build/**", ".next/**", ".venv/**", "venv/**", "__pycache__/**", ".pytest_cache/**"] },
  "attachment":  { "image": { "auto_resize": true, "max_width": 2000, "max_height": 2000, "max_base64_bytes": 5242880 } },
  "lsp": true,
  "formatter": true
}
