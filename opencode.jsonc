{
  "$schema": "https://opencode.ai/config.json",

  // Profile: set MODEL_A + MODEL_B di .env
  "model": "9router/{env:MODEL_A}",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "share": "disabled",
  "shell": "powershell",
  "snapshot": true,
  "autoupdate": "notify",
  "small_model": "9router/{env:MODEL_B}",
  "logLevel": "DEBUG",
  "instructions": ["AGENTS.md"],

  "enabled_providers": ["9router"],
  "provider": {
    "9router": {
      "name": "9Router Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["NINEROUTER_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "timeout": 300000, "headerTimeout": 90000, "chunkTimeout": 120000
      },
      "models": {
        "oc/big-pickle":                                  { "tool_call": true },
        "oc/deepseek-v4-flash-free":                      { "tool_call": true, "reasoning": true },
        "oc/mimo-v2.5-free":                              { "tool_call": true },
        "oc/nemotron-3-ultra-free":                       { "tool_call": true, "reasoning": true },
        "oc/north-mini-code-free":                        { "tool_call": true },
        "oc/ling-3.0-flash-free":                         { "tool_call": true, "reasoning": true },
        "openrouter/cohere/north-mini-code:free":         { "tool_call": true },
        "openrouter/nvidia/nemotron-3-super-120b-a12b:free": { "tool_call": true, "reasoning": true }
      }
    }
  },

  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask",
    "plan_enter": "deny", "plan_exit": "deny",
    "read": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" }
  },

  "experimental": {
    "primary_tools": ["todowrite", "question"],
    "continue_loop_on_deny": true,
    "mcp_timeout": 30000
  },

  "agent": {
    "build":      { "mode": "primary",   "color": "primary",   "permission": { "task": "deny" } },
    "plan":       { "mode": "primary",   "color": "secondary", "permission": { "task": "deny" } },
    "general":    { "mode": "subagent",  "permission": { "task": "deny" } },
    "explore":    { "mode": "subagent",  "permission": { "task": "deny" } },
    "title":      { "model": "9router/{env:MODEL_B}", "mode": "primary", "hidden": true },
    "summary":    { "model": "9router/{env:MODEL_B}", "mode": "primary", "hidden": true },
    "compaction": { "model": "9router/{env:MODEL_B}", "mode": "primary", "hidden": true }
  },

  "tool_output": { "max_lines": 2000, "max_bytes": 51200 },
  "compaction":  { "auto": true, "prune": false, "tail_turns": 2 },
  "watcher":     { "ignore": [".git/**", "node_modules/**", "dist/**", "build/**", ".next/**", ".venv/**", "venv/**", "__pycache__/**", ".pytest_cache/**"] },
  "attachment":  { "image": { "auto_resize": true, "max_width": 2000, "max_height": 2000, "max_base64_bytes": 5242880 } },
  "lsp": true,
  "formatter": true,

  "references": {
    "opencode-source": {
      "path": "C:\\Users\\FANNNDI\\Documents\\farewell-agent\\source\\opencode",
      "description": "OpenCode source Ã¢â‚¬â€ AI coding agent yang diorkestrasi oleh project ini"
    }
  }
}
