{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin-mocha",
  "scroll_speed": 3,
  "mouse": true,
  "diff_style": "auto",
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.3
