// Hooks configuration — event-driven lifecycle hooks
// Architecture: Zero-inspired. command+args[] separate, stdin JSON payload, exit codes
// Events: afterGenerate, beforeCommit, afterSessionStart
{
  "enabled": true,
  "hooks": [
    {
      "id": "auto-load-skills",
      "event": "afterSessionStart",
      "command": "python",
      "args": [".opencode/tools/auto-load-skills.py"],
      "enabled": true
    },
    {
      "id": "post-generate",
      "event": "afterGenerate",
      "command": "python",
      "args": [".opencode/hooks/post-generate.py"],
      "enabled": true
    },
    {
      "id": "check-links",
      "event": "beforeCommit",
      "command": "python",
      "args": [".opencode/scripts/check-links.py"],
      "enabled": true
    }
  ]
}
