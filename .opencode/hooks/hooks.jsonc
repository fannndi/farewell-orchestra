// Hooks configuration — event-driven lifecycle hooks
// Architecture: Zero-inspired. command+args[] separate, stdin JSON payload, exit codes
// Events: afterGenerate, beforeCommit
{
  "enabled": true,
  "hooks": [
    {
      "id": "post-generate",
      "event": "afterGenerate",
      "command": "powershell",
      "args": ["-NoProfile", "-File", ".opencode/hooks/post-generate.ps1"],
      "enabled": true
    },
    {
      "id": "check-links",
      "event": "beforeCommit",
      "command": "python",
      "args": [".opencode/scripts/check-links.py"],
      "enabled": true
    }
  ]
}
