# Farewell Orchestra — Model Aliases
# Copy ke .env:  copy .env.example .env
# Pilih 1 profile, uncomment, comment yang lain.

# Pro (default) — ocg/ paid, full tool call
# MODEL_A=ocg/deepseek-v4-pro
# MODEL_B=ocg/deepseek-v4-flash

# Flash — all flash
