# ═══════════════════════════════════════════════════════════════════
#  Farewell Orchestra — Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
#  Copy ke .env:  copy .env.example .env
#  Lalu edit .env sesuai profile yang diinginkan.
#  Jangan commit .env — sudah di-gitignore.
#
# ═══════════════════════════════════════════════════════════════════

# ── 9Router API Key (WAJIB) ─────────────────────────────────────
NINEROUTER_API_KEY=sk_9router

# ── Model Profiles ──────────────────────────────────────────────
#
#  Pro Profile (default):
#    HEAVY=ocg/deepseek-v4-pro
#    LIGHT=ocg/deepseek-v4-flash
#
#  Flash Profile (hemat):
#    HEAVY=ocg/deepseek-v4-flash
#    LIGHT=oc/deepseek-v4-flash-free
#
#  Custom: bebas mix-and-match

ORCHESTRA_HEAVY_MODEL=ocg/deepseek-v4-pro
ORCHESTRA_LIGHT_MODEL=ocg/deepseek-v4-flash

# ── (optional) Tambah model baru di sini, lalu daftarkan ────────
# ── di provider.models di opencode.jsonc                      ────
