# ║  Pro (default):                                                  ║
# ║    ORCHESTRA_HEAVY_MODEL=ocg/deepseek-v4-pro                     ║
# ║    ORCHESTRA_LIGHT_MODEL=ocg/deepseek-v4-flash                   ║
# ║                                                                  ║
# ║  Flash (hemat token):                                            ║
# ║    ORCHESTRA_HEAVY_MODEL=ocg/deepseek-v4-flash                   ║
# ║    ORCHESTRA_LIGHT_MODEL=oc/deepseek-v4-flash-free               ║
# ║                                                                  ║
# ║  Free (max hemat):                                               ║
# ║    ORCHESTRA_HEAVY_MODEL=oc/deepseek-v4-flash-free               ║
# ║    ORCHESTRA_LIGHT_MODEL=oc/deepseek-v4-flash-free               ║
# ║                                                                  ║
# ║  Custom:                                                         ║
# ║    edit 2 baris di bawah, bebas mix-and-match                    ║
# ╚══════════════════════════════════════════════════════════════════╝

# 9Router API Key (WAJIB)
NINEROUTER_API_KEY=sk_9router

# Model assignment — edit 2 baris ini aja
ORCHESTRA_HEAVY_MODEL=ocg/deepseek-v4-pro
ORCHESTRA_LIGHT_MODEL=ocg/deepseek-v4-flash

# Roles:
#   HEAVY → orchestrator
#   LIGHT → researcher, reviewer, executor, title, summary, compaction
