# MODEL_B=ocg/deepseek-v4-flash

# Free — Nemotron + flash, multi-provider
# MODEL_A=oc/nemotron-3-ultra-free
# MODEL_B=openrouter/nvidia/nemotron-3-super-120b-a12b:free

NINEROUTER_API_KEY=sk_9router