# Farewell Orchestra
# Gunakan switch.bat atau switch.ps1 untuk ganti profile
# Atau edit manual 2 baris di bawah

NINEROUTER_API_KEY=sk_9router

# Pro (default): HEAVY=ocg/deepseek-v4-pro  LIGHT=ocg/deepseek-v4-flash
# Flash (hemat):   HEAVY=ocg/deepseek-v4-flash LIGHT=oc/deepseek-v4-flash-free
# Free (max):      HEAVY=oc/deepseek-v4-flash-free LIGHT=oc/deepseek-v4-flash-free

ORCHESTRA_HEAVY_MODEL=ocg/deepseek-v4-pro
ORCHESTRA_LIGHT_MODEL=ocg/deepseek-v4-flash
